{
  "compilerOptions": {
    "target": "ES2024",
    "module": "node16",
    "lib": ["ES2024", "DOM"],
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  }
}
